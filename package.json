{
  "name": "shanghai-3d-city",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time 3D model of Shanghai in the browser, compiled from OpenStreetMap and elevation data with procedural detail.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317 --strictPort",
    "fetch": "node tools/pipeline/fetch.mjs",
    "compile": "node --max-old-space-size=4096 tools/pipeline/compile.mjs",
    "pipeline": "node tools/pipeline/fetch.mjs && node --max-old-space-size=4096 tools/pipeline/compile.mjs",
    "textures": "node tools/assets/fetch_textures.mjs",
    "test": "node --test tools/tests/"
  },
  "dependencies": {
    "earcut": "^2.2.4",
    "n8ao": "^2.0.1",
    "pngjs": "^7.0.0",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "jpeg-js": "^0.4.4",
    "ktx2-encoder": "^0.6.0",
    "vite": "^6.3.5"
  }
}
